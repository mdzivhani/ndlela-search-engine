PORT=3001
NODE_ENV=development
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=ndlela
JWT_SECRET=replace-with-a-long-random-secret
LOG_DIR=./logs
APP_URL=http://127.0.0.1:5173
# Public HTTPS API origin reachable by PayFast for ITNs.
PUBLIC_API_URL=
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated administrator email addresses, configured by the deployment owner.
ADMIN_EMAILS=
# Only set to the actual reverse proxy IP/CIDR. Never trust all forwarded IPs.
TRUSTED_PROXY=
